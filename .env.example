# --- ядро ---
SECRET_KEY=                 # openssl rand -hex 32; НИКОГДА не в git
DEBUG=0                     # 1 только в локальной dev-среде
ALLOWED_HOSTS=tykvogolos.onrender.com
CSRF_TRUSTED_ORIGINS=https://tykvogolos.onrender.com
TIME_ZONE=Europe/Moscow     # заменить на таймзону площадки; хранение всегда UTC (E7)

# --- БД ---
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# для планов B/C: sqlite:///data/db.sqlite3

# --- админ-панель (ТЗ §3) ---
ADMIN_LOGIN=max
ADMIN_PASSWORD=max             # openssl rand -base64 18; передать организатору лично, не в чатах
ADMIN_EMAIL=max@example.com    # superuser аварийного бэкдора /django-admin/ (username=max)

# --- правила и защита ---
VOTER_COOKIE_DAYS=30
SOFT_IP_LIMIT=0             # 0 = выкл (площадка за общим NAT, Т2); включать осознанно
VOTE_RATE_LIMIT=10          # отправок /api/v1/vote в минуту с IP (FR-V-12)
PHOTO_MAX_MB=5
LOGIN_MAX_ATTEMPTS=5        # неудач до лока
LOGIN_LOCK_MINUTES=10
